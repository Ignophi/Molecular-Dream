	author={Rolland, Yves and Sierra, Felipe and Ferrucci, Luigi and Barzilai, Nir and De Cabo, Rafael and Mannick, Joan and Oliva, Anthony and Evans, William and Angioni, Davide and De Souto Barreto, Philipe and others},
